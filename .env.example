# ==============================================================================
# VibeDebt Environment Configuration
# ==============================================================================

# Database Connection (Supabase / PostgreSQL)
# When set, VibeDebt persists waitlist signups and concierge orders to PostgreSQL.
# If omitted, VibeDebt automatically falls back to local disk storage in ./data/.
#
# Supabase connection example (pooled transaction connection):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# GitHub Personal Access Token (Optional)
# Increases GitHub API rate limit from 60 requests/hour to 5,000 requests/hour.
# Requires no scopes/permissions for public repositories.
# GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
GITHUB_TOKEN=
